    "better-auth": "^1.7.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "e2b": "^2.51.0",
    "express": "^5.2.1",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.85.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
