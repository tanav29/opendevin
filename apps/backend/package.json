{
  "name": "@opendevin/backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "db:generate": "prisma generate",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate de4v",
    "db:reset": "prisma migrate reset",
    "fmt": "oxfmt",
