// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Sessions {
  id          String  @id @default(cuid())
  git         String
  issueNumber Int?
  PRNumber    Int?
  // JSON-encoded AI SDK UIMessage[]; SQLite has no native JSON column.
  parts       String  @default("[]")
  archived    Boolean @default(false)
  status      String  @default("idle")
  sandbox     String
  cwd         String  @default("/home/user/")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runs      AgentRun[]
}

model AgentRun {
  id               String        @id @default(cuid())
  sessionId        String
  prompt           String
  status           String
  planJson         String        @default("{}")
  summary          String?
  branch           String?
  baseBranch       String?
  startedAt        DateTime?
  finishedAt       DateTime?
  cancelledAt      DateTime?
  validationStatus String?
  prTitle          String?
  prBody           String?
  session          Sessions      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  events           RunEvent[]
  artifacts        RunArtifact[]

  @@index([sessionId, createdAt])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RunEvent {
  id          String   @id @default(cuid())
  runId       String
  sequence    Int
  type        String
  status      String?
  message     String
  payloadJson String   @default("{}")
  createdAt   DateTime @default(now())
  run         AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId, createdAt])
}

model RunArtifact {
  id        String   @id @default(cuid())
  runId     String
  kind      String
  path      String?
  content   String
  truncated Boolean  @default(false)
  createdAt DateTime @default(now())
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, kind])
}
