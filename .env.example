# --- Convex (shared by backend + frontend) ---
# Copy this file to .env.local (repo root) and, for the frontend, to apps/frontend/.env.
# The backend reads apps/backend/.env (with the repo root .env.local as a fallback).
# Run `pnpm convex:dev` once to create the deployment, generate convex/_generated,
# and write the real CONVEX_URL to .env.local.

CONVEX_DEPLOYMENT=dev:your-slug # team: <team>, project: <project>
CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SITE_URL=https://your-deployment.convex.site

# --- Backend only (apps/backend/.env) ---
# E2B_API_KEY=...
# OPENROUTER_API_KEY=...
# MODEL=...